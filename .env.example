# Copy to .env and adjust. Never commit .env.
# --- LLM (optional; default "heuristic" runs fully offline) ---
DHARMANET_LLM_PROVIDER=heuristic          # heuristic | gemini | openai_compatible
DHARMANET_LLM_MODEL=                      # e.g. gemini-2.0-flash, gpt-4o-mini, llama3.1 (Ollama)
DHARMANET_LLM_BASE_URL=https://api.openai.com/v1   # Ollama: http://localhost:11434/v1
DHARMANET_LLM_API_KEY=
DHARMANET_LLM_MAX_RETRIES=2
DHARMANET_LLM_TEMPERATURE=0.2
# --- storage ---
# DHARMANET_DATABASE_URL=postgresql+psycopg://dharmanet:dharmanet@localhost:5432/dharmanet
# --- API hardening ---
DHARMANET_API_TOKEN=                      # if set, /api routes require "Authorization: Bearer <token>"
DHARMANET_RATE_LIMIT_PER_MINUTE=60
DHARMANET_CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005,http://localhost:3000,http://127.0.0.1:3000
# --- privacy ---
DHARMANET_STORE_DILEMMA_TEXT=true
DHARMANET_ANONYMIZE_INPUT=false
# --- frontend ---
BACKEND_URL=http://127.0.0.1:8005
